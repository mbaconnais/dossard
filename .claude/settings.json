{
  "permissions": {
    "deny": ["Read(./.env)", "Edit(scripts/legacy/**)"],
    "allow": ["mcp__dossard__list_views"],
    "ask": ["mcp__dossard__query_view"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/garde.py"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__dossard__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/journal_mcp.py"],
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/formate.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/tests_verts.py"]
          },
          { "type": "http", "url": "http://127.0.0.1:8765/hook" }
        ]
      }
    ]
  }
}
